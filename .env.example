# 1. CORE DJANGO CORE APPLICATION CONFIGURATIONS
APP_ENV=local
SECRET_KEY=your-cryptographic-secret-key-placeholder-change-this-locally
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

# 2. DATABASE CONFIGURATIONS
DB_CONNECTION=sqlite3
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=secure_db
DB_USERNAME=db_user_placeholder
DB_PASSWORD=db_password_placeholder

# 3. OWASP/ASVS COOKIES & SESSION SECURITY MIDDLEWARE
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_AGE=1800

# 4. HARDENED FILE UPLOAD GATEWAY CONTROLS
MAX_FILE_SIZE_MB=2
ALLOWED_FILE_EXTENSIONS=.png,.jpg,.jpeg,.gif

# 5. DEFENSIVE SECURITY LOGGING PROFILE
LOG_LEVEL=INFO
LOG_FILE_PATH=security_analysis/logs/app_security.log
